{
  "manifest_version": 3,
  "name": "GitLab Image Viewer - Thumbnail Gallery for Repos",
  "short_name": "GitLab Image Viewer",
  "version": "1.0.0",
  "description": "See every image in a GitLab folder as a thumbnail grid. Adjustable size, images per row, and a full-size lightbox.",
  "homepage_url": "https://AutomationXpert.github.io/Gitlab-Image-Viewer/",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GitLab Image Viewer settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gitlab.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
